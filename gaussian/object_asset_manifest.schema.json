{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phi-media-lab.example/schemas/object_asset_manifest.v1.json",
  "title": "Radeon OneLoop object asset preparation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_name",
    "created_utc",
    "formal",
    "redistribution",
    "source_root_committed",
    "coordinate_convention",
    "metric_anchor",
    "inputs",
    "views",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "radeon_oneloop.object_asset_manifest.v1"
    },
    "asset_name": {
      "type": "string",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "formal": {
      "const": false
    },
    "redistribution": {
      "const": false
    },
    "source_root_committed": {
      "const": false
    },
    "coordinate_convention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front_axis", "up_axis", "viewer_left_axis", "unit", "origin"],
      "properties": {
        "front_axis": {"const": "+Y"},
        "up_axis": {"const": "+Z"},
        "viewer_left_axis": {"const": "+X"},
        "unit": {"const": "m"},
        "origin": {"const": "plush_body_center"}
      }
    },
    "metric_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dimension", "value_m", "uncertainty_m", "status"],
      "properties": {
        "kind": {"const": "product_specification"},
        "dimension": {"const": "overall_height"},
        "value_m": {"type": "number", "exclusiveMinimum": 0},
        "uncertainty_m": {"type": "number", "minimum": 0},
        "status": {"const": "user_confirmed_metric_anchor"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_relpath",
        "config_sha256",
        "public_manifest_relpath",
        "public_manifest_sha256"
      ],
      "properties": {
        "config_relpath": {"type": "string", "pattern": "^(?!/).+"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "public_manifest_relpath": {"type": "string", "pattern": "^(?!/).+"},
        "public_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "views": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/view"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_count",
        "prepared_count",
        "observed_count",
        "generated_count",
        "tier_counts",
        "photometric_instance_ids",
        "anchor_pose_view_count",
        "evaluation_view_count",
        "mask_review_status"
      ],
      "properties": {
        "view_count": {"type": "integer", "minimum": 4},
        "prepared_count": {"type": "integer", "minimum": 0},
        "observed_count": {"type": "integer", "minimum": 0},
        "generated_count": {"type": "integer", "minimum": 0},
        "tier_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B", "C", "G"],
          "properties": {
            "A": {"type": "integer", "minimum": 0},
            "B": {"type": "integer", "minimum": 0},
            "C": {"type": "integer", "minimum": 0},
            "G": {"type": "integer", "minimum": 0}
          }
        },
        "photometric_instance_ids": {
          "type": "array",
          "maxItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "anchor_pose_view_count": {"type": "integer", "minimum": 4},
        "evaluation_view_count": {"type": "integer", "minimum": 4},
        "mask_review_status": {
          "enum": ["pending_visual_review", "reviewed_pass", "reviewed_fail"]
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "role": {
      "enum": [
        "pose",
        "photometric",
        "evaluation",
        "identity",
        "shape_prior",
        "generation_input",
        "domain_qa",
        "deformation_qa",
        "excluded"
      ]
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "instance_id",
        "source_relpath",
        "source_sha256",
        "tier",
        "provenance",
        "view_label",
        "roles",
        "canonical",
        "prepared",
        "mask_status"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
        "source_id": {"type": "string", "minLength": 1},
        "instance_id": {"type": "string", "minLength": 1},
        "source_relpath": {"$ref": "#/$defs/relative_path"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "tier": {"enum": ["A", "B", "C", "G"]},
        "provenance": {"enum": ["observed", "generated"]},
        "view_label": {"type": "string", "minLength": 1},
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/role"},
          "uniqueItems": true
        },
        "canonical": {"type": "boolean"},
        "exclusion_reason": {"type": "string", "minLength": 1},
        "nominal_camera_orbit_deg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["azimuth", "elevation"],
          "properties": {
            "azimuth": {"type": "number", "minimum": -360, "maximum": 360},
            "elevation": {"type": "number", "minimum": -90, "maximum": 90}
          }
        },
        "prepared": {"type": "boolean"},
        "mask_status": {
          "enum": ["not_applicable", "pending_visual_review", "reviewed_pass", "reviewed_fail"]
        },
        "mask_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method"],
          "properties": {
            "method": {"enum": ["grabcut_rect", "sam3_image_text_prompt"]},
            "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "candidate_view_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
            "candidate_mask_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "image": {"$ref": "#/$defs/prepared_file"},
        "neutral_image": {"$ref": "#/$defs/prepared_file"},
        "hard_mask": {"$ref": "#/$defs/prepared_file"},
        "soft_alpha": {"$ref": "#/$defs/prepared_file"},
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_width",
            "source_height",
            "crop_xyxy",
            "square_padding_ltrb",
            "output_width",
            "output_height",
            "source_to_output_affine_2x3"
          ],
          "properties": {
            "source_width": {"type": "integer", "minimum": 1},
            "source_height": {"type": "integer", "minimum": 1},
            "crop_xyxy": {
              "type": "array",
              "prefixItems": [
                {"type": "integer"},
                {"type": "integer"},
                {"type": "integer"},
                {"type": "integer"}
              ],
              "items": false
            },
            "square_padding_ltrb": {
              "type": "array",
              "prefixItems": [
                {"type": "integer", "minimum": 0},
                {"type": "integer", "minimum": 0},
                {"type": "integer", "minimum": 0},
                {"type": "integer", "minimum": 0}
              ],
              "items": false
            },
            "output_width": {"type": "integer", "minimum": 1},
            "output_height": {"type": "integer", "minimum": 1},
            "source_to_output_affine_2x3": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {"type": "number"}
              }
            }
          }
        },
        "mask_qa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["foreground_fraction", "touches_output_border", "foreground_bbox_xyxy"],
          "properties": {
            "foreground_fraction": {"type": "number", "minimum": 0, "maximum": 1},
            "touches_output_border": {"type": "boolean"},
            "foreground_bbox_xyxy": {
              "type": "array",
              "prefixItems": [
                {"type": "integer"},
                {"type": "integer"},
                {"type": "integer"},
                {"type": "integer"}
              ],
              "items": false
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"prepared": {"const": true}}},
          "then": {"required": ["mask_source", "image", "neutral_image", "hard_mask", "soft_alpha", "normalization", "mask_qa"]}
        },
        {
          "if": {"properties": {"provenance": {"const": "generated"}}},
          "then": {"properties": {"tier": {"const": "G"}}}
        },
        {
          "if": {"properties": {"canonical": {"const": false}}},
          "then": {"required": ["exclusion_reason"]}
        }
      ]
    },
    "prepared_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relpath", "sha256"],
      "properties": {
        "relpath": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
