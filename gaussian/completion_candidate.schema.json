{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phi-media-lab.example/schemas/completion_candidate.v1.json",
  "title": "Radeon OneLoop conditional point completion candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_utc",
    "formal",
    "eligible_for_formal_metrics",
    "eligible_for_heldout_real_metrics",
    "generator",
    "coordinate_convention",
    "metric_anchor",
    "observed_core",
    "completion",
    "sidecars",
    "conditioning",
    "canonical_transform",
    "source_label_values"
  ],
  "properties": {
    "schema_version": {
      "const": "radeon_oneloop.completion_candidate.v1"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "formal": {
      "const": false
    },
    "eligible_for_formal_metrics": {
      "const": false
    },
    "eligible_for_heldout_real_metrics": {
      "const": false
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "host_role", "accelerator", "conditional", "seed"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "host_role": {"type": "string", "minLength": 1},
        "accelerator": {"type": "string", "minLength": 1},
        "conditional": {"const": true},
        "seed": {"type": "integer", "minimum": 0},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "coordinate_convention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front_axis", "up_axis", "viewer_left_axis", "unit", "origin"],
      "properties": {
        "front_axis": {"const": "+Y"},
        "up_axis": {"const": "+Z"},
        "viewer_left_axis": {"const": "+X"},
        "unit": {"const": "m"},
        "origin": {"const": "plush_body_center"}
      }
    },
    "metric_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "value_m"],
      "properties": {
        "dimension": {"const": "overall_height"},
        "value_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "observed_core": {"$ref": "#/$defs/pointArtifact"},
    "completion": {"$ref": "#/$defs/completionArtifact"},
    "sidecars": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "source_labels"],
      "properties": {
        "confidence": {"$ref": "#/$defs/npyArtifact"},
        "source_labels": {"$ref": "#/$defs/npyArtifact"}
      }
    },
    "conditioning": {"$ref": "#/$defs/jsonArtifact"},
    "canonical_transform": {"$ref": "#/$defs/jsonArtifact"},
    "source_label_values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "generated", "rejected"],
      "properties": {
        "observed": {"const": 0},
        "generated": {"const": 1},
        "rejected": {"const": 2}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "pointArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relpath", "bytes", "sha256", "vertex_count", "ply_format"],
      "properties": {
        "relpath": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "vertex_count": {"type": "integer", "minimum": 1},
        "ply_format": {
          "enum": ["ascii", "binary_little_endian", "binary_big_endian"]
        }
      }
    },
    "completionArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relpath",
        "bytes",
        "sha256",
        "vertex_count",
        "ply_format",
        "point_set_role",
        "observed_core_frozen"
      ],
      "properties": {
        "relpath": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "vertex_count": {"type": "integer", "minimum": 1},
        "ply_format": {
          "enum": ["ascii", "binary_little_endian", "binary_big_endian"]
        },
        "point_set_role": {
          "enum": ["generated_fill_only", "full_candidate"]
        },
        "observed_core_frozen": {"const": true}
      }
    },
    "npyArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relpath", "bytes", "sha256", "dtype", "shape", "derivation"],
      "properties": {
        "relpath": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "dtype": {"type": "string", "minLength": 1},
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "derivation": {"type": "string", "minLength": 1}
      }
    },
    "jsonArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relpath", "bytes", "sha256"],
      "properties": {
        "relpath": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
